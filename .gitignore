# ============================================================
# Shabeer Ahmed Portfolio – .gitignore
# ============================================================

# --- Secrets (NEVER commit) ---
.env
.env.local
*.env
server/.env

# --- Python ---
server/mingit/
__pycache__/
*.py[cod]
*.so
server/venv/
venv/
ENV/
*.egg-info/

# --- SQLite database (local dev only) ---
server/inquiries.db
*.db
*.sqlite3

# --- Node & Frontend ---
node_modules/
client/node_modules/
npm-debug.log*
yarn-debug.log*
.npm

# --- Vite build (Vercel will rebuild this — commit optional) ---
dist/
client/dist/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.idea/
*.swp
*.swo

.vercel
