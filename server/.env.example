# ==============================================================================
# Environment Configuration for Shabeer Ahmed Portfolio Backend
# ==============================================================================

# Server Environment (development / production)
FLASK_ENV=development
PORT=5000
SECRET_KEY=your-super-secret-key-change-in-production

# Database Configuration
# Leave blank to automatically use local SQLite (sqlite:///inquiries.db)
# Or provide PostgreSQL URI (e.g., postgresql://username:password@localhost:5432/portfolio_db)
DATABASE_URL=

# Admin Dashboard API Key (protects /api/inquiries endpoint)
ADMIN_API_KEY=shabeer-dev-secret-2025

# Email Notifications (SMTP)
# Optional: Inquiries are always saved to database even if SMTP is disabled.
# To enable real email alerts to yourself and auto-responders to clients:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=wa363969@gmail.com
SMTP_PASS=your-google-app-password
NOTIFICATION_RECEIVER=wa363969@gmail.com
